# ─── Stage 1: build ───────────────────────────────────────────────────────────
# Debian-based builder — glibc is required for CGO plugin loading at runtime.
FROM --platform=$BUILDPLATFORM golang:1.26 AS builder

ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Download host module dependencies first (cached layer).
COPY go.mod go.sum ./
COPY sdk/ ./sdk/
RUN go mod download

# Copy all source.
COPY . .

# Build the host binary with CGO enabled.
# CGO is required so the binary can call plugin.Open() at runtime.
RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /jaiscloud ./cmd/jaiscloud/

# Build the aws-emr-spark plugin.
# The replace directive in go.mod (../../sdk) resolves to /src/sdk inside this stage.
WORKDIR /src/plugins/aws-emr-spark
RUN go mod download
RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildmode=plugin -o /plugins/aws-emr-spark.so .

# ─── Stage 2: runtime ─────────────────────────────────────────────────────────
# debian:bookworm-slim provides glibc so the CGO-linked binary and .so load correctly.
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /jaiscloud /jaiscloud
COPY --from=builder /plugins/  /plugins/

EXPOSE 4566

ENTRYPOINT ["/jaiscloud"]
# Default: full mode requires --dsn via env var JAISCLOUD_DSN.
# Plugins are loaded from /plugins at startup.
CMD ["start", "--plugin-dir", "/plugins"]
